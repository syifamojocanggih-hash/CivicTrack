# ==========================================================
# Konfigurasi Lingkungan Backend CivicTrack
# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi lokal Anda
# ==========================================================

# Nama Aplikasi & Environment
APP_NAME=CivicTrack API
ENVIRONMENT=development
DEBUG=True

# Koneksi Basis Data MySQL
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<nama_database>
DATABASE_URL=mysql+pymysql://root:@localhost:3306/civictrack_db

# Keamanan JWT
# Gunakan string acak yang kuat untuk produksi (misal: openssl rand -hex 32)
SECRET_KEY=civictrack-super-secret-key-development-change-in-production-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini AI API Key
# Dapatkan gratis di https://aistudio.google.com/
# Jika dikosongkan, backend akan beralih ke mock-mode cerdas tanpa error.
GEMINI_API_KEY=

# Penyimpanan Berkas Media Lokal
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,mp4,mov
